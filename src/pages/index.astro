---
import ContactFace from '../components/ContactFace.astro';
import SectionArrow from '../components/SectionArrow.astro';
import Site from '../layouts/Site.astro';
import portfolio from '../data/portfolio';

const home = import.meta.env.BASE_URL;
const projectUrl = (slug: string) => `${home}projects/${slug}/`;
---
<Site showFooter={false}>
  <section class="intro frame" id="about" aria-labelledby="intro-name">
    <div class="intro-identity">
      <h1 id="intro-name">{portfolio.name}</h1>
      <p class="intro-statement">i like building software and learning stuff.</p>
      <p>{portfolio.role} at {portfolio.school}</p>
    </div>
    <div class="intro-about">
      <h2 class="section-label">About</h2>
      <div class="editorial-copy">
        {portfolio.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <SectionArrow />

  <section class="frame section" id="projects" aria-labelledby="project-heading">
    <div class="section-title">
      <h2 id="project-heading">Projects</h2>
    </div>
    <div class="project-list">
      {portfolio.projects.map((project) => {
        const cover = project.media.find((item) => item.type === 'image');
        return (
          <article class="project-row">
            <a class="project-link" href={projectUrl(project.slug)}>
              <div class:list={['project-cover', `cover-${project.slug}`]} aria-hidden="true">
                {cover
                  ? <img src={home + cover.src} alt="" loading="lazy" />
                  : <span>{project.short}</span>}
              </div>
              <div class="project-info">
                <p class="label">{project.label}</p>
                <h3>{project.title}</h3>
                <p class="project-stack">{project.stack.join(' / ')}</p>
                <span class="project-cta">View</span>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </section>

  <SectionArrow />

  <section class="frame section" id="skills" aria-labelledby="skills-heading">
    <h2 class="section-label" id="skills-heading">Skills &amp; Experience</h2>
    <div class="editorial-copy">
      {portfolio.skills.map((skill) => (
        <div class="skill">
          <h3>{skill.title}</h3>
          <ul>
            {skill.items.map((item) => (
              <li>
                {item.text}
                {item.projects && (
                  <div class="related-links">
                    {portfolio.projects.filter((project) => item.projects?.includes(project.slug)).map((project) => (
                      <a href={projectUrl(project.slug)}>{project.short}</a>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-heading">
    <ContactFace />
    <div class="frame contact-inner">
      <h2 id="contact-heading">Contact</h2>
      <div class="contact-links">
        {portfolio.contact.map((link) => <a href={link.url.includes(':') ? link.url : home + link.url}>{link.label}</a>)}
      </div>
    </div>
  </section>
</Site>
