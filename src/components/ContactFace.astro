---
const face = [
  '...#######...',
  '..#.......#..',
  '.#.........#.',
  '#..+.....+..#',
  '#..+.....+..#',
  '#..+.....+..#',
  '#...........#',
  '#...........#',
  '#..+.....+..#',
  '#...+...+...#',
  '.#...+++...#.',
  '..#.......#..',
  '...#######...',
];

const cells = face.flatMap((row, y) =>
  Array.from(row, (cell, x) => {
    if (cell === '.') return '';
    const color = cell === '+' ? '#FF5500' : '#A0A0A0';
    return `<use href="#tile" x="${x * 12}" y="${y * 12}" color="${color}"/>`;
  }),
).join('');
const image = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 228 228">
  <defs>
    <g id="tile">
      <path d="M.5.5h10v10h-10z" fill="none" stroke="currentColor"/>
      <path d="M2 3h7l-3.5 5.5z" fill="none" stroke="currentColor" stroke-width=".65"/>
    </g>
    <g id="face" transform="translate(-77.5 -77.5)">${cells}</g>
  </defs>
  <use href="#face"/>
  <use href="#face" x="228"/>
  <use href="#face" y="228"/>
  <use href="#face" x="228" y="228"/>
  <use href="#face" transform="translate(114 114) scale(.55)"/>
  <use href="#face" transform="translate(114 0) scale(.3 .6)"/>
  <use href="#face" transform="translate(114 228) scale(.3 .6)"/>
  <use href="#face" transform="translate(0 114) scale(.6 .3)"/>
  <use href="#face" transform="translate(228 114) scale(.6 .3)"/>
</svg>`;
const background = `url("data:image/svg+xml,${encodeURIComponent(image)}")`;
---
<div class="contact-faces" aria-hidden="true" style={{ '--contact-pattern': background }}></div>
