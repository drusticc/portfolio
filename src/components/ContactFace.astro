---
const face = [
  '...#######...',
  '..#.......#..',
  '.#.........#.',
  '#..+.....+..#',
  '#..+.....+..#',
  '#..+.....+..#',
  '#...........#',
  '#...........#',
  '#..+.....+..#',
  '#...+...+...#',
  '.#...+++...#.',
  '..#.......#..',
  '...#######...',
];
const tiles = face.join('').split('');
---
<div class="contact-faces" aria-hidden="true">
  {Array.from({ length: 5 }, () => (
    <div class="contact-face">
      {tiles.map((cell) => (
        <span class:list={{ 'geometric-tile': cell !== '.', 'face-accent': cell === '+' }}></span>
      ))}
    </div>
  ))}
</div>
