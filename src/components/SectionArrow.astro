---
const rowWidths = [1, 1, 1, 7, 5, 3, 1];
---
<div class="section-arrow" aria-hidden="true">
  {Array.from({ length: 5 }, () => (
    <div class="section-arrow-shape">
      {rowWidths.map((width) => (
        <div class="section-arrow-row">
          {Array.from({ length: width }, () => <span></span>)}
        </div>
      ))}
    </div>
  ))}
</div>
