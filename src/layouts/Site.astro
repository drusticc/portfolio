---
import portfolio from '../data/portfolio';
import '../styles/site.css';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const home = import.meta.env.BASE_URL;
const nav = [
  ['Projects', '#projects'],
  ['About', '#about'],
  ['Skills', '#skills'],
  ['Contact', '#contact'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F4F1EA" />
    <meta name="description" content={`${portfolio.name} | ${portfolio.role} at ${portfolio.school}`} />
    <title>{title ? `${title} | ${portfolio.name}` : portfolio.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header">
      <div class="frame header-inner">
        <a href={home} class="wordmark">{portfolio.name}<span aria-hidden="true">■</span></a>
        <nav aria-label="Main navigation">
          {nav.map(([label, hash]) => <a href={home + hash}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="frame footer-inner">
        <a class="wordmark" href={home}>{portfolio.name}<span aria-hidden="true">■</span></a>
        <div class="footer-links">
          {portfolio.contact.map((link) => <a href={link.url.includes(':') ? link.url : home + link.url}>{link.label}</a>)}
        </div>
      </div>
    </footer>
  </body>
</html>
