---
import portfolio from '../data/portfolio';
import '../styles/site.css';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const home = import.meta.env.BASE_URL;
const nav = [
  ['About', '#about'],
  ['Projects', '#projects'],
  ['Skills', '#skills'],
  ['Contact', '#contact'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1A1A1A" />
    <script is:inline>
      (() => {
        const storageKey = 'hudson-portfolio-theme';
        const root = document.documentElement;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        let preference = 'dark';
        let toggle;

        try {
          const saved = localStorage.getItem(storageKey);
          if (saved === 'light' || saved === 'dark') preference = saved;
        } catch {
          // The theme still works when storage is unavailable.
        }

        function applyTheme() {
          const dark = preference === 'dark';
          root.dataset.theme = dark ? 'dark' : 'light';
          themeColor?.setAttribute('content', dark ? '#1A1A1A' : '#F4F1EA');
          toggle?.setAttribute('aria-pressed', String(dark));
        }

        applyTheme();
        document.addEventListener('DOMContentLoaded', () => {
          toggle = document.querySelector('[data-theme-toggle]');
          if (!toggle) return;
          applyTheme();
          toggle.hidden = false;
          toggle.addEventListener('click', () => {
            preference = root.dataset.theme === 'dark' ? 'light' : 'dark';
            applyTheme();
            try {
              localStorage.setItem(storageKey, preference);
            } catch {
              // Keep the new preference for this page.
            }
          });
        });
      })();
    </script>
    <meta name="description" content={`${portfolio.name} | ${portfolio.role} at ${portfolio.school}`} />
    <title>{title ? `${title} | ${portfolio.name}` : portfolio.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header">
      <div class="frame header-inner">
        <a href={home} class="wordmark">{portfolio.name}</a>
        <div class="header-controls">
          <nav aria-label="Main navigation">
            {nav.map(([label, hash]) => <a href={home + hash}>{label}</a>)}
          </nav>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Dark mode" aria-pressed="true" title="Dark mode" hidden><span class="theme-moon" aria-hidden="true"></span></button>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="frame footer-inner">
        <a class="wordmark" href={home}>{portfolio.name}</a>
        <div class="footer-links">
          {portfolio.contact.map((link) => <a href={link.url.includes(':') ? link.url : home + link.url}>{link.label}</a>)}
        </div>
      </div>
    </footer>
  </body>
</html>
